{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Responses",
  "description": "Capture HTTP response metadata for requests made during page load.",
  "type": "object",
  "additionalProperties": false,
  "required_plugins": [
    "chrome"
  ],
  "required_binaries": [],
  "output_mimetypes": [
    "application/x-ndjson",
    "text/",
    "image/",
    "audio/",
    "video/",
    "application/",
    "font/"
  ],
  "properties": {
    "RESPONSES_ENABLED": {
      "type": "boolean",
      "default": true,
      "x-aliases": [
        "SAVE_RESPONSES",
        "USE_RESPONSES"
      ],
      "description": "Enable HTTP response capture"
    },
    "RESPONSES_TIMEOUT": {
      "type": "integer",
      "default": 30,
      "minimum": 5,
      "x-fallback": "TIMEOUT",
      "description": "Timeout for response capture in seconds"
    }
  },
  "category": "media",
  "display_order": 20,
  "snapshot_output_group": "embedded_media",
  "presentation_module": "abx_plugins.plugins.responses.presentation",
  "snapshot_thumbnail_cards": [
    {"archive_result_name": "responses", "order": 4}
  ]
}

{
  "name": "archivebox-browser-extension",
  "description": "Archive pages locally with the full ArchiveBox JS/WASM engine and manage your ArchiveBox servers",
  "private": true,
  "version": "3.3.8",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "dev:firefox": "wxt -b firefox --mv3",
    "dev:safari": "wxt -b safari --mv3",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:safari": "wxt build -b safari --mv3",
    "test": "pnpm build && playwright test",
    "zip": "wxt zip",
    "zip:edge": "wxt zip -b edge",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "zip:safari": "wxt zip -b safari --mv3",
    "zip:stores": "pnpm zip && pnpm zip:edge && pnpm zip:firefox && pnpm zip:safari",
    "submit:chrome": "wxt submit --chrome-extension-id habonpimjphpdnmcfkaockjnffodikoj --chrome-zip .output/archivebox-browser-extension-$npm_package_version-chrome.zip",
    "submit:edge": "wxt submit --edge-zip .output/archivebox-browser-extension-$npm_package_version-edge.zip",
    "submit:edge:dry-run": "wxt submit --dry-run --edge-zip .output/archivebox-browser-extension-$npm_package_version-edge.zip",
    "submit:firefox": "wxt submit --firefox-extension-id archivebox@tjhorner.dev --firefox-zip .output/archivebox-browser-extension-$npm_package_version-firefox.zip --firefox-sources-zip .output/archivebox-browser-extension-$npm_package_version-sources.zip",
    "submit:stores": "wxt submit --chrome-extension-id habonpimjphpdnmcfkaockjnffodikoj --chrome-zip .output/archivebox-browser-extension-$npm_package_version-chrome.zip --edge-zip .output/archivebox-browser-extension-$npm_package_version-edge.zip --firefox-extension-id archivebox@tjhorner.dev --firefox-zip .output/archivebox-browser-extension-$npm_package_version-firefox.zip --firefox-sources-zip .output/archivebox-browser-extension-$npm_package_version-sources.zip",
    "convert:safari": "pnpm build:safari && xcrun safari-web-extension-converter .output/safari-mv3",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "site:build": "node docs/site/build.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "site:verify": "node scripts/verify-site.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@llamaindex/liteparse-wasm": "2.15.1",
    "@mozilla/readability": "^0.6.0",
    "@paddleocr/paddleocr-js": "0.4.2",
    "@peculiar/x509": "1.14.3",
    "@postlight/parser": "2.2.3",
    "@webrecorder/wabac": "2.27.3",
    "@zip.js/zip.js": "2.23.0",
    "browsertrix-behaviors": "0.15.0",
    "buffer": "^6.0.3",
    "client-zip": "^2.5.1",
    "dashjs": "^5.2.1",
    "defuddle": "^0.19.4",
    "dompurify": "^3.4.16",
    "events": "^3.3.0",
    "fflate": "^0.8.3",
    "hash-wasm": "^4.12.0",
    "hls.js": "^1.7.3",
    "image-size": "2.0.2",
    "isomorphic-git": "^1.43.0",
    "jsonc-parser": "3.3.1",
    "linkedom": "^0.18.13",
    "lit": "3.1.1",
    "lucide-react": "^1.52.0",
    "m3u8-parser": "^7.2.0",
    "memfs": "^4.80.0",
    "minisearch": "7.2.0",
    "mpd-parser": "^1.4.0",
    "mupdf": "1.28.1",
    "officeparser": "8.1.0",
    "pako": "^3.0.2",
    "parse5": "^8.0.1",
    "path-browserify": "^1.0.1",
    "pyodide": "0.29.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "readable-stream": "^4.7.0",
    "single-file-core": "1.6.24",
    "url": "^0.11.4",
    "uuid": "^14.0.2",
    "warcio": "2.4.12",
    "@wxt-dev/i18n": "^0.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "replaywebpage": "2.5.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "wxt": "^0.21.4",
    "esbuild": "^0.28.2",
    "marked": "^18.1.0"
  },
  "license": "AGPL-3.0-or-later"
}
